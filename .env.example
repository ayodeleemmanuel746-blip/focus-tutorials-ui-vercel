# Separate Neon TEST project connection string (do not use your live Render database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Random secret of at least 32 characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# First administrator account for this test deployment
ADMIN_NAME=FOCUS Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Website URL used in registration emails
SITE_URL=https://your-vercel-test-domain.vercel.app

# Email: Resend is recommended; SMTP remains supported as fallback
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=FOCUS TUTORIALS UI <verified-sender@example.com>

# Optional Gmail SMTP settings (used when EMAIL_PROVIDER=smtp)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=

# Supabase Storage (private bucket created in your Supabase project)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_BUCKET=focus-tutorials-files
# Server-only secret/service-role key. NEVER expose this in browser code or commit it.
SUPABASE_SECRET_KEY=
# Public anon/publishable key; safe to send to the browser for the signed upload request.
SUPABASE_PUBLISHABLE_KEY=
